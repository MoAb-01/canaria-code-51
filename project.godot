; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Canaria Code 51"
run/main_scene="res://scenes/opening/opening_cinematic.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

FullscreenManager="*res://scripts/autoload/fullscreen_manager.gd"
DialogueLayer="*res://scenes/ui/dialogue_layer.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=4
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[gui]

theme/default_font_subpixel_positioning=0
theme/default_font_antialiasing=0

[rendering]

environment/defaults/default_clear_color=Color(0, 0, 0, 1)
textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
