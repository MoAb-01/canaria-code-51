[node name="UiClickRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 32

[node name="TitleLabel" type="Label" parent="VBox/UiClickRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.898, 0.929, 0.961, 1)
theme_override_colors/font_shadow_color = Color(0.05, 0.03, 0.02, 0.95)
theme_override_colors/font_outline_color = Color(0.11, 0.07, 0.05, 1)
theme_override_constants/shadow_offset_x = 3
theme_override_constants/shadow_offset_y = 3
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 28
text = "UI CLICKS"

[node name="ValueLabel" type="Label" parent="VBox/UiClickRow"]
layout_mode = 2
theme_override_colors/font_color = Color(0.898, 0.929, 0.961, 1)
theme_override_colors/font_shadow_color = Color(0.05, 0.03, 0.02, 0.95)
theme_override_colors/font_outline_color = Color(0.11, 0.07, 0.05, 1)
theme_override_constants/shadow_offset_x = 3
theme_override_constants/shadow_offset_y = 3
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 28
text = "<  ON  >"

[node name="DisplayRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 32

[node name="TitleLabel" type="Label" parent="VBox/DisplayRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.898, 0.929, 0.961, 1)
theme_override_colors/font_shadow_color = Color(0.05, 0.03, 0.02, 0.95)
theme_override_colors/font_outline_color = Color(0.11, 0.07, 0.05, 1)
theme_override_constants/shadow_offset_x = 3
theme_override_constants/shadow_offset_y = 3
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 28
text = "DISPLAY"

[node name="ValueLabel" type="Label" parent="VBox/DisplayRow"]
layout_mode = 2
theme_override_colors/font_color = Color(0.898, 0.929, 0.961, 1)
theme_override_colors/font_shadow_color = Color(0.05, 0.03, 0.02, 0.95)
theme_override_colors/font_outline_color = Color(0.11, 0.07, 0.05, 1)
theme_override_constants/shadow_offset_x = 3
theme_override_constants/shadow_offset_y = 3
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 28
text = "< FULLSCREEN >"

[node name="BackBtn" type="Button" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.898, 0.929, 0.961, 1)
theme_override_colors/font_focus_color = Color(1, 0.604, 0.122, 1)
theme_override_colors/font_pressed_color = Color(1, 0.604, 0.122, 1)
theme_override_colors/font_hover_color = Color(1, 0.604, 0.122, 1)
theme_override_colors/font_shadow_color = Color(0.05, 0.03, 0.02, 0.95)
theme_override_colors/font_outline_color = Color(0.11, 0.07, 0.05, 1)
theme_override_constants/shadow_offset_x = 4
theme_override_constants/shadow_offset_y = 4
theme_override_constants/outline_size = 10
theme_override_font_sizes/font_size = 32
theme_override_styles/normal = SubResource("StyleBoxEmpty_btn")
theme_override_styles/pressed = SubResource("StyleBoxEmpty_btn")
theme_override_styles/hover = SubResource("StyleBoxEmpty_btn")
theme_override_styles/disabled = SubResource("StyleBoxEmpty_btn")
theme_override_styles/focus = SubResource("StyleBoxEmpty_btn")
text = "> BACK"
flat = true
alignment = 0

[node name="HoverSound" type="AudioStreamPlayer" parent="."]
stream = ExtResource("2_hover_sfx")
bus = &"SFX"

[node name="ClickSound" type="AudioStreamPlayer" parent="."]
stream = ExtResource("3_click_sfx")
bus = &"SFX"
