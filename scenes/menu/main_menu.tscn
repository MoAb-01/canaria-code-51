[ext_resource type="AudioStream" path="res://assets/audio/teaser_ambient_16s.wav" id="7_amb_audio"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_ocean"]
shader = ExtResource("3_water_shd")
shader_parameter/wave_speed = 2.2
shader_parameter/wave_freq = 24.0
shader_parameter/wave_amp = 0.0035
shader_parameter/horizon_y = 0.675

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
