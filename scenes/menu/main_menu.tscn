[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/menu/main_menu.gd" id="1_menu_scr"]
[ext_resource type="Theme" path="res://themes/coastal_theme.tres" id="2_theme"]
[ext_resource type="Shader" path="res://shaders/ocean_water.gdshader" id="3_water_shd"]
[ext_resource type="Texture2D" path="res://assets/textures/clean_scene_1080p.png" id="4_clean_bg"]
